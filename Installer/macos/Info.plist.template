  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Shyshyroong Downloader Protocol</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>mpdl</string>
      </array>
    </dict>
  </array>
