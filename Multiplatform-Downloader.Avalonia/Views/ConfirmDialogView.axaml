<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Multiplatform_Downloader.Avalonia.Views.ConfirmDialogView"
        Background="{DynamicResource WfBgBrush}"
        Foreground="{DynamicResource WfInkBrush}"
        Title="{Binding Title}"
        Width="430" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Border Background="{DynamicResource WfSurfaceBrush}" Margin="14" CornerRadius="10"
          BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="1" Padding="20,18">
    <StackPanel>
      <DockPanel>
        <Viewbox Width="21" Height="21" Margin="0,2,10,0" VerticalAlignment="Top">
          <Path Classes="wfIcon" Data="{StaticResource IcoAlert}"
                Stroke="{DynamicResource WfWarnBrush}"/>
        </Viewbox>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Message}" FontSize="13" Margin="0,7,0,0"
                     TextWrapping="Wrap" Opacity="0.85" LineHeight="19"/>
        </StackPanel>
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Theme="{StaticResource CardButtonDanger}" Command="{Binding Confirm}" Content="{Binding ConfirmText}"
                Height="34" Padding="18,0" MinWidth="92" Margin="0,0,8,0" IsDefault="True"/>
        <Button Theme="{StaticResource CardButton}" Command="{Binding Cancel}" Content="{Binding CancelText}"
                Height="34" Padding="18,0" MinWidth="80" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
