<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Multiplatform_Downloader.Avalonia</RootNamespace>
    <AssemblyName>Multiplatform-Downloader.Avalonia</AssemblyName>
    <Version>2.13.10</Version>
    <AssemblyTitle>샤샤룽 다운로더</AssemblyTitle>
    <Product>샤샤룽 다운로더</Product>
    <Company>샤샤룽컴퍼니</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- 번들 엔진(yt-dlp/ffmpeg/ffprobe/deno, macOS 빌드) — 출력의 tools/ 로 복사 -->
  <ItemGroup>
    <None Include="tools/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Autofac" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Multiplatform-Downloader.Core\Multiplatform-Downloader.Core.csproj" />
  </ItemGroup>

</Project>
