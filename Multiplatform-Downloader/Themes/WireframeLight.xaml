<!-- 와이어프레임 라이트 팔레트 (docs/design/multiplatform-downloader-wireframe.html :root) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WfBgBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="WfSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WfInkBrush" Color="#1C1E21"/>
    <SolidColorBrush x:Key="WfInk2Brush" Color="#5F6672"/>
    <SolidColorBrush x:Key="WfLineBrush" Color="#D9DDE3"/>
    <SolidColorBrush x:Key="WfAccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="WfAccentSoftBrush" Color="#DBEAFE"/>

    <!-- 파생 토큰: 컨트롤 상태 -->
    <SolidColorBrush x:Key="WfChipBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="WfHoverBrush" Color="#EBEEF3"/>
    <SolidColorBrush x:Key="WfPressedBrush" Color="#DFE4EB"/>

    <!-- 주요 버튼(.btn.pri) — 흰 글씨 대비 확보를 위해 두 테마 동일 -->
    <SolidColorBrush x:Key="WfPrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="WfPrimaryHoverBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="WfPrimaryPressedBrush" Color="#1D4ED8"/>

    <!-- 위험 액션(고스트) -->
    <SolidColorBrush x:Key="WfDangerFgBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WfDangerBorderBrush" Color="#66DC2626"/>
    <SolidColorBrush x:Key="WfDangerHoverBrush" Color="#14DC2626"/>
    <SolidColorBrush x:Key="WfDangerPressedBrush" Color="#26DC2626"/>

    <!-- 상태 (ok/warn/err — 와이어프레임 공용값, warn만 가독성 보정) -->
    <SolidColorBrush x:Key="WfOkBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WfWarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WfErrBrush" Color="#DC2626"/>

    <!-- 리디자인 신규 토큰(FR-U1.1) — 기존 키 불변, 추가만. 브랜드는 현행 블루 유지(V-04) -->
    <SolidColorBrush x:Key="WfSurface2Brush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="WfLine2Brush" Color="#C3CAD4"/>
    <SolidColorBrush x:Key="WfOkSoftBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WfWarnSoftBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WfErrSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="WfFocusBrush" Color="#2563EB"/>
</ResourceDictionary>
