<Window x:Class="Multiplatform_Downloader.Views.UpdateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WfBgBrush}"
        TextElement.Foreground="{DynamicResource WfInkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="/Assets/app.ico"
        Title="업데이트"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource WfSurfaceBrush}" Margin="14" CornerRadius="10"
            BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="1" Padding="20,18">
        <StackPanel>
            <DockPanel>
                <Viewbox Width="22" Height="22" Margin="0,2,10,0" VerticalAlignment="Top">
                    <Path Style="{StaticResource WfIcon}" Data="{StaticResource IcoDownload}"
                          Stroke="{DynamicResource WfAccentBrush}"/>
                </Viewbox>
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold">
                        <Run Text="새 버전 "/><Run Text="{Binding NewVersion, Mode=OneWay}"/><Run Text=" 사용 가능"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" Opacity="0.85" LineHeight="18"/>
                </StackPanel>
            </DockPanel>

            <!-- 릴리스 노트 — 평문만(FR-U4.2), 스크롤 -->
            <Border Margin="0,14,0,0" CornerRadius="6" Background="{DynamicResource WfBgBrush}"
                    BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="1" Padding="12,10"
                    Visibility="{Binding ShowPromptButtons, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ReleaseNotes}" FontSize="12" TextWrapping="Wrap"
                               Opacity="0.9" LineHeight="18" FontFamily="Consolas, Segoe UI"/>
                </ScrollViewer>
            </Border>

            <!-- 다운로드 진행 -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{DynamicResource WfAccentBrush}"
                             Background="{DynamicResource WfLineBrush}" BorderThickness="0"/>
            </StackPanel>

            <!-- 버튼 -->
            <Grid Margin="0,18,0,0">
                <!-- 안내 상태 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding ShowPromptButtons, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="Skip" Content="이 버전 건너뛰기" Style="{StaticResource CardButton}"
                            Height="34" Padding="14,0" Margin="0,0,8,0" Opacity="0.75"/>
                    <Button x:Name="Later" Content="나중에" Style="{StaticResource CardButton}"
                            Height="34" Padding="18,0" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="InstallNow" Content="지금 설치" Style="{StaticResource CardButtonPrimary}"
                            Height="34" Padding="20,0" MinWidth="96" IsDefault="True"/>
                </StackPanel>
                <!-- 다운로드 중 상태 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="CancelDownload" Content="취소" Style="{StaticResource CardButton}"
                            Height="34" Padding="18,0" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
