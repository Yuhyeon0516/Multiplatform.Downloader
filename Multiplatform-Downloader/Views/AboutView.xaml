<Window x:Class="Multiplatform_Downloader.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://caliburnmicro.com"
        Background="{DynamicResource WfSurfaceBrush}"
        TextElement.Foreground="{DynamicResource WfInkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Title="정보" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더: 로고 + 이름 + 버전 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="66" Height="66" CornerRadius="17" Background="{DynamicResource WfPrimaryBrush}"
                    VerticalAlignment="Top">
                <Viewbox Width="28" Height="28" Margin="3,0,0,0">
                    <Path Style="{StaticResource WfIconFill}" Data="{StaticResource IcoPlay}" Fill="White"/>
                </Viewbox>
            </Border>
            <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="Bold"/>
                    <Border Background="{DynamicResource WfAccentSoftBrush}" CornerRadius="8" Padding="8,2" Margin="10,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WfAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ProductNameEn}" FontSize="12.5" Opacity="0.6" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding SubTitle}" FontSize="12.5" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- 본문: 개발자 · 엔진 · 사용 범위 -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <Border BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="개발자" Width="86" Opacity="0.6" FontSize="13"/>
                        <TextBlock Text="{Binding Developer}" FontSize="13" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="번들 엔진" Width="86" Opacity="0.6" FontSize="13"/>
                        <TextBlock Text="{Binding EngineInfo}" FontSize="12.5" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="사용 범위" Width="86" Opacity="0.6" FontSize="13"/>
                        <TextBlock Text="{Binding UsageNotice}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                    </DockPanel>
                    <!-- 수동 업데이트 확인(FR-U6.2) -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="업데이트" Width="86" Opacity="0.6" FontSize="13"/>
                        <Button x:Name="CheckUpdate" DockPanel.Dock="Left" Content="업데이트 확인"
                                MinWidth="104" Padding="12,5" IsEnabled="{Binding CanCheckUpdate}"/>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Opacity="0.85"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 하단 버튼 -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" x:Name="OpenLegalNotice" Content="라이선스 고지" MinWidth="110" Padding="12,7"/>
            <Button x:Name="Close" Content="닫기" MinWidth="90" Padding="12,7" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
