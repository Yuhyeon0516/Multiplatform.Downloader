<Window x:Class="Multiplatform_Downloader.Views.ConfirmDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WfBgBrush}"
        TextElement.Foreground="{DynamicResource WfInkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="/Assets/app.ico"
        Title="{Binding Title}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 버튼 스타일은 Themes/Controls.xaml 공용(FR-U1.4) -->

    <Border Background="{DynamicResource WfSurfaceBrush}" Margin="14" CornerRadius="10"
            BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="1" Padding="20,18">
        <StackPanel>
            <DockPanel>
                <Viewbox Width="21" Height="21" Margin="0,2,10,0" VerticalAlignment="Top">
                    <Path Style="{StaticResource WfIcon}" Data="{StaticResource IcoAlert}"
                          Stroke="{DynamicResource WfWarnBrush}"/>
                </Viewbox>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Message}" FontSize="13" Margin="0,7,0,0"
                               TextWrapping="Wrap" Opacity="0.85" LineHeight="19"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="Confirm" Content="{Binding ConfirmText}" Style="{StaticResource CardButtonDanger}" Height="34" Padding="18,0"
                        MinWidth="92" Margin="0,0,8,0" IsDefault="True"/>
                <Button x:Name="Cancel" Content="{Binding CancelText}" Style="{StaticResource CardButton}" Height="34" Padding="18,0"
                        MinWidth="80" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
