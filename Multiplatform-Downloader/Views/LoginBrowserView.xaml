<Window x:Class="Multiplatform_Downloader.Views.LoginBrowserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Background="{DynamicResource WfSurfaceBrush}"
        TextElement.Foreground="{DynamicResource WfInkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="/Assets/app.ico"
        Title="로그인 / 확인 — 샤샤룽 다운로더" Height="780" Width="1040"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource WfLineBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="Complete" Content="완료" MinWidth="88" Margin="0,0,8,0"
                            ToolTip="로그인·확인을 마쳤다면 눌러 세션을 저장합니다"/>
                    <Button x:Name="Cancel" Content="취소" MinWidth="72"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="13" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
