<Window x:Class="Multiplatform_Downloader.Views.PlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Background="{DynamicResource WfSurfaceBrush}"
        TextElement.Foreground="{DynamicResource WfInkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="/Assets/app.ico"
        Title="{Binding WindowTitle}" Height="620" Width="960" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- 상단 정보 바: 제목·메타 + 폴백/폴더 (§9.1) -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="0,0,0,1"
                Padding="12,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="OpenFolder" Style="{StaticResource IconButton}"
                        ToolTip="파일 위치 열기">
                    <Viewbox Width="14" Height="14">
                        <Path Style="{StaticResource WfIcon}" Data="{StaticResource IcoFolder}"/>
                    </Viewbox>
                </Button>
                <Button DockPanel.Dock="Right" x:Name="OpenInDefaultPlayer" Style="{StaticResource CardButton}"
                        ToolTip="연결된 기본 플레이어로 열기 — 인앱 재생이 안 되는 코덱(AV1 등) 폴백">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                            <Path Style="{StaticResource WfIcon}" Data="{StaticResource IcoExternal}"/>
                        </Viewbox>
                        <TextBlock Text="기본 플레이어" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MetaInfo}" FontSize="11" Foreground="{DynamicResource WfInk2Brush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource WfWarnBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 하단: 이전/다음 완료 항목 + 단축키 안내 -->
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource WfLineBrush}" BorderThickness="0,1,0,0"
                Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="10.5" Foreground="{DynamicResource WfInk2Brush}"
                           VerticalAlignment="Center"
                           Text="Space 재생/일시정지 · F 전체화면 · 창 닫기 = 완전 정지"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevItem" Style="{StaticResource CardButton}" Content="◂ 이전 완료 항목"/>
                    <Button x:Name="NextItem" Style="{StaticResource CardButton}" Content="다음 완료 항목 ▸"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 영상 영역 — Chromium 내장 컨트롤 사용, 배경 항상 검정 -->
        <Border Background="Black">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>
    </DockPanel>
</Window>
